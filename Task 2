.tabs{display:flex;gap:6px;margin:12px 0 18px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:5px;overflow-x:auto}.tabs button{flex:1;white-space:nowrap;border:0;background:none;color:var(--mut);font:700 14px Inter,sans-serif;padding:10px 12px;border-radius:10px;cursor:pointer}.tabs button.on{background:var(--navy);color:var(--card)}
.btn{background:var(--navy);color:var(--card);border:0;border-radius:12px;padding:11px 18px;font:700 14px Inter,sans-serif;cursor:pointer}.btn.alt{background:var(--tealbg);color:var(--teal)}.btn.gold{background:var(--gold);color:#fff}.btn:disabled{opacity:.5;cursor:wait}
textarea,input[type=text]{width:100%;background:var(--card);color:var(--ink);border:1.5px solid var(--line);border-radius:12px;padding:11px 14px;font:inherit}textarea{min-height:130px;resize:vertical}textarea:focus,input:focus{outline:2px solid var(--teal);border-color:transparent}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:14px;margin-bottom:12px;background:var(--card)}table{border-collapse:collapse;width:100%;font-size:14px}th{background:var(--navy);color:var(--card);text-align:left;padding:9px 12px;font-size:12.5px;white-space:nowrap}td{padding:9px 12px;border-top:1px solid var(--line);vertical-align:top}td:first-child{font-weight:700;color:var(--navy)}
.formula{background:var(--navy);color:var(--card);border-radius:14px;padding:12px 16px;margin-bottom:10px;font-weight:700}.formula div{margin:2px 0}
.box{border-left:4px solid var(--teal);background:var(--card);border-radius:12px;padding:10px 14px;margin-bottom:10px;border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.box.bad{border-left-color:var(--bad);background:var(--badbg)}.box.uz{border-left-color:var(--gold);background:var(--goldbg)}.box b.t{display:block;font-size:12px;letter-spacing:.08em;color:var(--teal)}.box.bad b.t{color:var(--bad)}.box.uz b.t{color:var(--gold)}.box div{margin:2px 0;font-size:14.5px}
mark{background:var(--mk);color:inherit;padding:0 3px;border-radius:5px;font-weight:600}.cloze mark{background:none;padding:0}
input.gap{display:inline-block;width:auto;padding:1px 8px;border-radius:8px;border-width:1.5px;font:600 14px Inter,sans-serif}input.gap.ok{border-color:var(--ok);background:var(--okbg)}input.gap.no{border-color:var(--bad);background:var(--badbg)}
.essay p{margin:0 0 12px}.lab{font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--teal);display:block}
.q{font-size:18px;font-weight:700;color:var(--navy);margin:6px 0 12px}.opt{display:block;width:100%;text-align:left;background:var(--card);color:var(--ink);border:1.5px solid var(--line);border-radius:12px;padding:11px 14px;margin-bottom:8px;font:600 15px Inter,sans-serif;cursor:pointer}.opt:hover:not(:disabled){border-color:var(--teal)}.opt.ok{background:var(--okbg);border-color:var(--ok);color:var(--ok)}.opt.no{background:var(--badbg);border-color:var(--bad);color:var(--bad)}
.bar{height:8px;background:var(--line);border-radius:9px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--teal),var(--gold))}.meta{display:flex;justify-content:space-between;color:var(--mut);font-size:13px;font-weight:600;margin-bottom:8px}
.fc{cursor:pointer;display:flex;justify-content:space-between;gap:10px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:8px;font-weight:600}.fc span.u{color:var(--teal);font-weight:500;font-size:14px;display:none}.fc.on span.u{display:block}.fc.on{border-color:var(--teal)}
.big{font-size:48px;font-weight:800;color:var(--navy);line-height:1}.cen{text-align:center}.mut{color:var(--mut);font-size:13.5px}
.bands{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:8px;margin-bottom:12px}.bd{background:var(--tealbg);border-radius:12px;padding:8px;text-align:center}.bd b{display:block;font-size:24px;color:var(--navy)}.bd span{font-size:11px;font-weight:700;color:var(--teal)}.bd.ov{background:var(--navy)}.bd.ov b,.bd.ov span{color:var(--card)}
.fb li{margin-bottom:8px}.fb .w{color:var(--bad);font-weight:600;text-decoration:line-through}.fb .r{color:var(--ok);font-weight:700}
details{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px 14px;margin:8px 0}summary{cursor:pointer;font-weight:700;color:var(--teal);font-size:14px}
.tag{font-size:11px;font-weight:800;padding:2px 8px;border-radius:6px;margin-right:6px}.tag.b{background:var(--okbg);color:var(--ok)}.tag.d{background:var(--badbg);color:var(--bad)}
footer{text-align:center;color:var(--mut);font-size:13px;padding:24px 16px calc(24px + env(safe-area-inset-bottom,0px))}footer b{color:var(--navy)}
