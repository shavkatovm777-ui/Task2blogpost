  $('#ck').onclick=async()=>{const ans=[...v.querySelectorAll('textarea')].map((t,i)=>({n:i+1,task:e.items[i].q+(e.items[i].h?' ['+e.items[i].h+']':''),answer:t.value.trim()})).filter(a=>a.answer);if(!ans.length){$('#fbx').innerHTML='<div class="box bad">Avval kamida bitta javob yozing.</div>';return}
   $('#ck').disabled=true;$('#fbx').innerHTML='<p class="mut">AI tekshirmoqda…</p>';
   try{const t=await ai(`You are an IELTS Writing Task 2 teacher for Uzbek-speaking students. Exercise: "${e.title}". Instruction: ${e.ins}\nCheck each student answer. For each: say ✓ or ✗, give the corrected/model version, and a one-line reason (English, with a short Uzbek hint). Be concise.\n${JSON.stringify(ans)}`);$('#fbx').innerHTML=`<div class="card" style="white-space:pre-wrap">${esc(t)}</div>`;ps('x'+n,'bajarildi');bump('exr')}catch(er){$('#fbx').innerHTML=aiErr(er)}$('#ck').disabled=false}}}

const AREA=['Hissiy','Aqliy','Jismoniy','Ijtimoiy','Moliyaviy'];
function blist(){app.innerHTML=`<h1>Idea Bank</h1><p class="mut">20 mavzu · 200 g‘oya · chunklar o‘zbekcha tarjima bilan.</p><div class="grid">${BK.bank.map(t=>`<div class="tc" onclick="go('b${pad(t.n)}')"><div class="num">${t.n}</div><div><h3>${esc(t.title)}</h3><p>${esc(t.uz)}</p>${pg('bt'+t.n)?`<span class="chip g">Chunk testi ${pg('bt'+t.n)}</span>`:''}</div></div>`).join('')}</div>`}
function bank(n,tab){const t=BK.bank.find(x=>x.n===n);if(!t)return blist();
 app.innerHTML=`<span class="crumb" onclick="go('b')">← Idea Bank</span><h1>${t.n}. ${esc(t.title)}</h1><div class="mut">${esc(t.uz)}</div><div class="card" style="margin-top:10px"><span class="lab">TASK 2 QUESTION</span>${esc(t.q)}</div><div class="tabs">${[['ideas','Ideyalar'],['test','Chunk testi']].map(([k,l])=>`<button class="${k===tab?'on':''}" onclick="go('b${pad(n)}${k==='ideas'?'':'-'+k}')">${l}</button>`).join('')}</div><div id="v"></div>`;const v=$('#v');
 if(tab==='test'){const pool=t.ideas.flatMap(i=>i.ch);const run=()=>mcq(v,shuf(pool).slice(0,10).map((c,k)=>{const o=shuf([c[1],...shuf(pool.filter(x=>x[1]!==c[1])).slice(0,3).map(x=>x[1])]);return{q:'“'+c[0]+'” — qaysi tarjima to‘g‘ri?',o,a:o.indexOf(c[1])}}),(s,tt)=>ps('bt'+n,Math.max(pg('bt'+n,0)?+String(pg('bt'+n)).split('/')[0]:0,s)+'/'+tt),run,'');run();return}
 v.innerHTML=t.ideas.map(i=>`<div class="card"><span class="tag ${i.p?'b':'d'}">${i.p?'▲ BENEFIT':'▼ DRAWBACK'}</span><span class="chip">${i.c} · ${AREA[(+i.c.split('.')[1]-1)>>1]}</span><p style="margin:8px 0;font-weight:500">${hl(i.en,i.ch)}</p>${i.ch.map(c=>`<div class="mut">◆ <b>${esc(c[0])}</b> = ${esc(c[1])}</div>`).join('')}<details><summary>Tarjima</summary>${esc(i.uz)}</details><details><summary>Zanjir qur (Explanation → Result → Example)</summary><textarea placeholder="Explanation (when/if/because/by…), Result (As a result… / which leads to…), Example (For example…)" style="min-height:90px"></textarea><button class="btn alt" data-ai="${i.c}" style="margin-top:8px">AI tekshirsin</button><div class="o" style="margin-top:8px"></div></details></div>`).join('');
 v.onclick=async ev=>{const b=ev.target.closest('[data-ai]');if(!b)return;const d=b.parentNode,ta=d.querySelector('textarea'),o=d.querySelector('.o'),i=t.ideas.find(x=>x.c===b.dataset.ai);if(ta.value.trim().length<20){o.innerHTML='<span class="mut">Avval zanjirni yozing.</span>';return}
  b.disabled=true;o.innerHTML='<span class="mut">AI tekshirmoqda…</span>';try{const r=await ai(`IELTS Writing Task 2 teacher. Idea: "${i.en}". The student wrote the continuation (Explanation → Result → Example):\n"${ta.value.trim()}"\nGive short feedback (max 120 words): is each step present (Explanation with when/if/because/by/through; Result with As a result/which leads to/thereby + V-ing; realistic Example)? Correct grammar errors by quoting them, and give one improved version. Add a one-line Uzbek summary.`);o.innerHTML=`<div style="white-space:pre-wrap">${esc(r)}</div>`;bump('exr')}catch(er){o.innerHTML=aiErr(er)}b.disabled=false}}

function cloze(paras,on){return paras.map(p=>`<p>${on?esc(p).replace(/«(.*?)»/g,(m,c)=>`<input class="gap" type="text" data-a="${esc(c)}" size="${Math.max(6,c.length*.8|0)}" autocomplete="off" autocapitalize="off">`):mk(p)}</p>`).join('')}
function checkGaps(root){let ok=0,all=0;root.querySelectorAll('input.gap').forEach(i=>{all++;const g=norm(i.value)===norm(i.dataset.a);i.classList.toggle('ok',g);i.classList.toggle('no',!g);if(g)ok++;else i.title=i.dataset.a});return[ok,all]}
function elist(){app.innerHTML=`<h1>Namuna essaylar</h1><p class="mut">Har bir essay Idea Bank chunklaridan tuzilgan. Chunklar belgilangan.</p><div class="grid">${BK.essays.map((e,i)=>`<div class="tc" onclick="go('e${i+1}')"><div class="num">${i+1}</div><div><h3>${esc(e.title)}</h3><p>${esc(e.q).slice(0,100)}…</p></div></div>`).join('')}</div>`}
function essay(n){const e=BK.essays[n-1];if(!e)return elist();const L=['INTRO','BODY 1','BODY 2','CONCLUSION'];let on=false;
 const draw=()=>{$('#es').innerHTML=e.paras.map((p,i)=>`<div class="card"><span class="lab">${L[i]||''}</span><div class="essay">${cloze([p],on)}</div></div>`).join('')};
 app.innerHTML=`<span class="crumb" onclick="go('e')">← Essaylar</span><h1>${n}. ${esc(e.title)}</h1><div class="card"><span class="lab">TASK 2 QUESTION</span>${esc(e.q)}</div><div style="margin:10px 0"><button class="btn alt" id="tg">Chunklarni yashirish (mashq)</button> <button class="btn" id="ck" style="display:none">Tekshirish</button> <span id="sc" class="mut"></span></div><div id="es"></div><h2>X-ray</h2><div class="tw"><table><tr>${e.xray.head.map(h=>`<th>${esc(h)}</th>`).join('')}</tr>${e.xray.rows.map(r=>`<tr>${r.map(c=>`<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</table></div><div class="box uz"><b class="t">QANDAY O‘RGANISH KERAK</b><div>1) Bir marta o‘qing. 2) Explanation va Result konnektorlarini belgilang. 3) Chunklarni yashirib, xotiradan to‘ldiring. 4) Body 2’ni boshqa g‘oya bilan qayta yozing.</div></div>`;
 draw();$('#tg').onclick=()=>{on=!on;draw();$('#ck').style.display=on?'':'none';$('#tg').textContent=on?'Chunklarni ko‘rsatish':'Chunklarni yashirish (mashq)';$('#sc').textContent=''};
 $('#ck').onclick=()=>{const[o,a]=checkGaps($('#es'));$('#sc').textContent=o+'/'+a+' to‘g‘ri'}}

function wlist(){app.innerHTML=`<h1>30 ta Task 2 mavzu</h1><p class="mut">Har bir mavzuda yozish va AI feedback bor. Har bir mavzuda: namuna essay (Intro → Body 1 → Body 2 → Conclusion), 30 ta chunk, chunk testi, mashq va AI feedback bilan yozish.</p><div class="grid">${W.map(t=>`<div class="tc" onclick="go('w${pad(t.n)}')"><div class="num">${t.n}</div><div><h3>${esc(t.title||t.q.slice(0,60)+'…')}</h3><p>${esc(t.q).slice(0,110)}${t.q.length>110?'…':''}</p>${t.essay?'<span class="chip o">Essay + 30 chunk</span>':'<span class="chip">Yozish + AI</span>'}${pg('wb'+t.n)?`<span class="chip g">Chunk testi ${pg('wb'+t.n)}</span>`:''}${pg('ws'+t.n)?'<span class="chip">Yozilgan</span>':''}</div></div>`).join('')}</div>`}
function wt(n,tab){const t=W[n-1];if(!t)return wlist();const ready=!!t.essay;
 const tabs=ready?[['essay','Namuna essay'],['chunks','30 chunk'],['mashq','Mashq'],['yozish','Yozish + AI']]:[['yozish','Yozish + AI']];if(!ready)tab='yozish';
 app.innerHTML=`<span class="crumb" onclick="go('w')">← Mavzular</span><h1>${n}. ${esc(t.title||'Task 2 mavzu')}</h1><div class="card"><span class="lab">TASK 2 QUESTION${t.kind?' · '+esc(t.kind).toUpperCase():''}</span>${esc(t.q)}<div class="mut" style="margin-top:6px">180–200+ so‘z. Sabablar va misollar bilan asoslang.</div></div><div class="tabs">${tabs.map(([k,l])=>`<button class="${k===tab?'on':''}" onclick="go('w${pad(n)}${k==='essay'?'':'-'+k}')">${l}</button>`).join('')}</div><div id="v"></div>`;const v=$('#v');
 if(tab==='essay'){const L=['INTRO','BODY 1','BODY 2','CONCLUSION'];v.innerHTML=`<p class="mut">${t.wc} so‘z · sariq rangdagi iboralar — yodlanadigan chunklar.</p>${t.essay.map((p,i)=>`<div class="card"><span class="lab">${L[i]}</span><div class="essay">${cloze([p],false)}</div></div>`).join('')}<div class="box uz"><b class="t">KEYINGI QADAM</b><div>Chunklarni o‘rganing (“30 chunk”), “Mashq”da xotiradan to‘ldiring, so‘ng o‘zingiz yozing va AI’ga yuboring.</div></div>`}
 else if(tab==='chunks'){v.innerHTML=`<p class="mut">Iborani bosing — o‘zbekcha tarjima chiqadi. Avval ingliz tilida eslashga urinib ko‘ring.</p>`+t.chunks.map(c=>`<div class="fc"><div>${esc(c[0])}<span class="u">${esc(c[1])}</span></div><span>👁</span></div>`).join('')+`<h2>Chunk testi</h2><div id="q"></div>`;
  v.querySelectorAll('.fc').forEach(f=>f.onclick=()=>f.classList.toggle('on'));const pool=t.chunks;const run=()=>mcq($('#q'),shuf(pool).slice(0,10).map(c=>{const o=shuf([c[0],...shuf(pool.filter(x=>x[0]!==c[0])).slice(0,3).map(x=>x[0])]);return{q:'“'+c[1]+'” — inglizcha qaysi ibora?',o,a:o.indexOf(c[0])}}),(s,tt)=>ps('wb'+n,s+'/'+tt),run,'');run()}
 else if(tab==='mashq'){v.innerHTML=`<p class="mut">Namuna essayni yopib, chunklarni xotiradan to‘ldiring.</p><div id="es">${t.essay.map(p=>`<div class="card essay cloze">${cloze([p],true)}</div>`).join('')}</div><div style="margin:10px 0"><button class="btn" id="ck">Tekshirish</button> <span id="sc" class="mut"></span></div>`;$('#ck').onclick=()=>{const[o,a]=checkGaps($('#es'));$('#sc').textContent=o+'/'+a+' to‘g‘ri — xato joylarda to‘g‘ri javob sichqoncha ustida ko‘rinadi'}}
 else{const kd='ws'+n;v.innerHTML=`<p class="mut">Namuna essay va chunklarni o‘rganib bo‘lgach, o‘z essayingizni yozing. Yuborganingizdan so‘ng AI grammatika, uslub va Lexical Resource bo‘yicha feedback beradi.</p><textarea id="ta" style="min-height:300px" placeholder="Essayingizni shu yerga yozing…">${esc(pg(kd,''))}</textarea><div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0"><span id="wc" class="mut"></span><button class="btn gold" id="sb">Yuborish va AI feedback</button></div><div id="fb"></div>`;
  const ta=$('#ta'),upd=()=>{const w=(ta.value.trim().match(/\S+/g)||[]).length;$('#wc').textContent=w+' so‘z'+(w<180?' (kamida 180 kerak)':'');ps(kd,ta.value)};ta.oninput=upd;upd();
  $('#sb').onclick=async()=>{const w=(ta.value.trim().match(/\S+/g)||[]).length;if(w<60){$('#fb').innerHTML='<div class="box bad"><b class="t">JUDA QISQA</b><div>Feedback olish uchun kamida 60 so‘z yozing (ideal: 180–220).</div></div>';return}
   $('#sb').disabled=true;$('#fb').innerHTML='<p class="mut">AI essayingizni tahlil qilmoqda… (20–40 soniya)</p>';
   const ch=t.chunks?t.chunks.map(c=>c[0]).join('; '):'(none provided for this topic)';
   try{const o=await ai(`You are a strict but supportive IELTS Writing Task 2 examiner and teacher for Uzbek-speaking learners. Score on a 6-POINT scale (0 to 6, steps of 0.5) for each criterion: TR (Task Response), CC (Coherence & Cohesion), LR (Lexical Resource), GRA (Grammatical Range & Accuracy). 6 = excellent, 5 = good, 4 = adequate, 3 = weak, 2 = poor, 1 = very poor, 0 = no attempt. overall = average of the four, rounded to the nearest 0.5.
TASK: ${t.q}
TARGET CHUNKS for this topic (natural collocations the student should try to use): ${ch}
STUDENT ESSAY (${w} words):
\"\"\"${ta.value.trim()}\"\"\"
Return ONLY valid JSON, no markdown, with exactly this shape:
{"band":{"TR":0,"CC":0,"LR":0,"GRA":0,"overall":0},"summary_uz":"2-3 sentences in Uzbek: overall verdict","strengths":["..."],"grammar":[{"wrong":"exact quote from essay","right":"correction","rule":"short rule in English + brief Uzbek hint"}],"style":[{"issue":"task response / structure / cohesion / repetition / tone problem","fix":"how to fix it"}],"lexical":[{"weak":"word or phrase used","better":"more natural alternative or topic chunk","why":"short reason"}],"chunks_used":["target chunks the student used"],"chunks_missing":["up to 6 target chunks worth adding"],"rewrite":"an improved version of the weakest paragraph, keeping the student's ideas","next_steps":["3 concrete actions"]}
Rules: be honest (essays under 150 words must be penalised); list up to 10 real grammar errors (articles, tenses, agreement, prepositions, punctuation, word forms) quoting exactly; never invent errors; check the Idea → Explanation → Result → Example development in body paragraphs and the While-intro / However-body-2 / In conclusion structure; comment on position clarity, paragraphing and linking; keep each item short.`,true);
    const ov=+o.band&&0;try{const sc=+(o.band||{}).overall;if(sc>=0){const st=ST();st.sc=(st.sc||[]).concat([sc]).slice(-50);bump('ess')}}catch(e){}
    $('#fb').innerHTML=fbHTML(o)}catch(er){$('#fb').innerHTML=aiErr(er)}$('#sb').disabled=false}}}
function fbHTML(o){const b=o.band||{},L=(a,f)=>a&&a.length?`<ul>${a.map(f).join('')}</ul>`:'<p class="mut">—</p>';
 return`<div class="card fb"><h2 style="margin-top:0">Baho (6 ballik tizim)</h2><div class="bands">${[['TR','Task Response'],['CC','Coherence'],['LR','Lexical Res.'],['GRA','Grammar']].map(([k,l])=>`<div class="bd"><b>${esc(b[k]??'–')}<small style="font-size:12px">/6</small></b><span>${l}</span></div>`).join('')}<div class="bd ov"><b>${esc(b.overall??'–')}<small style="font-size:12px">/6</small></b><span>JAMI</span></div></div><p>${esc(o.summary_uz||'')}</p>
 <h2>Kuchli tomonlar</h2>${L(o.strengths,s=>`<li>${esc(s)}</li>`)}
 <h2>Grammatika xatolari</h2>${L(o.grammar,g=>`<li><span class="w">${esc(g.wrong)}</span> → <span class="r">${esc(g.right)}</span><div class="mut">${esc(g.rule||'')}</div></li>`)}
 <h2>Uslub va tuzilma</h2>${L(o.style,s=>`<li><b>${esc(s.issue)}</b><div class="mut">${esc(s.fix||'')}</div></li>`)}
 <h2>Lexical Resource</h2>${L(o.lexical,x=>`<li><span class="w">${esc(x.weak)}</span> → <span class="r">${esc(x.better)}</span><div class="mut">${esc(x.why||'')}</div></li>`)}
 ${(o.chunks_used||[]).length?`<h2>Ishlatilgan chunklar</h2>${o.chunks_used.map(c=>`<span class="chip o">${esc(c)}</span>`).join('')}`:''}${(o.chunks_missing||[]).length?`<h2>Qo‘shish mumkin bo‘lgan chunklar</h2>${o.chunks_missing.map(c=>`<span class="chip g">${esc(c)}</span>`).join('')}`:''}
 <h2>Yaxshilangan variant</h2><div class="box uz"><div style="white-space:pre-wrap">${esc(o.rewrite||'')}</div></div><h2>Keyingi qadamlar</h2>${L(o.next_steps,s=>`<li>${esc(s)}</li>`)}</div>`}
route();
</script>
